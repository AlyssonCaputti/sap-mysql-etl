# Copie para .env e preencha. O .env nunca vai pro git.

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Pasta de rede onde o ERP publica as exportações. Sem isso, o pipeline procura
# em ./integracao.
ETL_PASTA_INTEGRACAO=

# Regras de negócio — a carteira do cliente vem da última compra nesta marca.
ETL_MARCA_FOCO=MARCA_A

# Campo customizado do ERP que marca o cliente da marca foco, e o nome dele no
# destino. Varia por instalação.
# ETL_COLUNA_MARCA_ORIGEM=U_MarcaFoco
# ETL_COLUNA_MARCA_DESTINO=marca_foco

# Pasta dos vendedores. Usa truncate pra preservar o schema ajustado à mão, então
# o nome tem que casar com a pasta real — sem isso cai no replace e perde o ajuste.
# ETL_PASTA_VENDEDORES=vendedores ilha

# Tabelas que já existem no banco com nome diferente do que o código geraria.
# Formato: pasta=NomeNoBanco, separado por ponto e vírgula.
# ETL_NOMES_LEGADOS=pasta-com-acento=NomeAntigoNoBanco

# Nomes dos arquivos que o ERP exporta — variam por instalação.
# ETL_SUBPASTA_FATURAMENTO=faturamento
# ETL_ARQ_FATURAMENTO=faturamento.csv
# ETL_ARQ_CLIENTES=clientes.xlsx
# ETL_ARQ_VENDEDORES=vendedores.xlsx
# ETL_ARQ_ITENS=itens.csv

# Opcionais — só se quiser mudar os caminhos padrão.
# ETL_PASTA_DADOS=       # padrão: ./dados
# ETL_PASTA_SAIDA=       # padrão: ./dados/para_vps
# ETL_PASTA_SKU_CUSTO=   # padrão: <integração>/sku_custo
# ETL_REF_CLIENTES=      # planilha com os nomes técnicos do SAP
# ETL_TAMANHO_LOTE=5000  # baixe para 2000 se der "Packet too large"
