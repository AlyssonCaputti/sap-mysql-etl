# Copie para .env e preencha. O .env nunca vai pro git.

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Opcionais — só se quiser mudar os caminhos padrão.
# ETL_PASTA_DADOS=       # padrão: ./dados
# ETL_PASTA_SAIDA=       # padrão: ./dados/para_vps
# ETL_PASTA_SKU_CUSTO=   # padrão: a pasta sku_custo_cd_giba na rede
#
# Origens. Por padrão todas leem da rede; aponte pra dados/ quando o P: cair.
# ETL_ORIGEM_CLIENTES=
# ETL_ORIGEM_ITENS=
# ETL_ORIGEM_FATURAMENTO=
# ETL_ORIGEM_VENDEDORES=
# ETL_ORIGEM_PRECO_REVENDA=
# ETL_ORIGEM_IMAGEM_URL=
# ETL_REF_CLIENTES=      # planilha com os nomes técnicos do SAP
# ETL_TAMANHO_LOTE=5000  # baixe para 2000 se der "Packet too large"

# Alerta por e-mail quando um pipeline falha.
# Sem ALERTA_SMTP_HOST e ALERTA_PARA o alerta fica desligado e o ETL roda igual.
ALERTA_SMTP_HOST=          # ex.: smtp.office365.com
ALERTA_SMTP_PORTA=587
ALERTA_SMTP_USUARIO=
ALERTA_SMTP_SENHA=
ALERTA_DE=                 # remetente; vazio usa o USUARIO
ALERTA_PARA=               # destinatarios, separados por virgula
# ALERTA_SMTP_TLS=1        # 0 desliga o STARTTLS (SMTP interno sem TLS)
